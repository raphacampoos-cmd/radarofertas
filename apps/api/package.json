    "drizzle-orm": "^0.36.0",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8",
    "crypto": "*"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
